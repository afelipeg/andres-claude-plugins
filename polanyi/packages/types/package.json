{
  "name": "@openagency/types",
  "version": "0.1.0",
  "description": "TypeScript types for OpenAgency",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
