{
  "name": "@openagency/engines",
  "version": "0.1.0",
  "description": "4 computation engines for OpenAgency: Leak Detector, Media Architect, Campaign Ops, Executive Bridge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
