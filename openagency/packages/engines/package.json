{
  "name": "@openagency/engines",
  "version": "0.1.0",
  "description": "5 engines for OpenAgency: Leak Detector, Media Architect, Campaign Ops, Executive Bridge, Delivery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openagency/types": "workspace:*",
    "@openagency/schemas": "workspace:*",
    "@openagency/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.782.0",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.0.0",
    "ulid": "^2.3.0",
    "pdfkit": "^0.15.2",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.9",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
