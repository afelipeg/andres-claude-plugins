    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openagency/types": "workspace:*",
    "@openagency/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
