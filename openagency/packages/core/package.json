{
  "name": "@openagency/core",
  "version": "0.1.0",
  "description": "Core orchestration, LLM abstraction, and utilities for OpenAgency",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils/math": {
      "types": "./dist/utils/math.d.ts",
      "import": "./dist/utils/math.js"
    },
    "./utils/format": {
      "types": "./dist/utils/format.d.ts",
      "import": "./dist/utils/format.js"
    },
    "./data/parser": {
      "types": "./dist/data/parser.d.ts",
      "import": "./dist/data/parser.js"
    },
    "./data/file-parser": {
      "types": "./dist/data/file-parser.d.ts",
      "import": "./dist/data/file-parser.js"
    },
    "./data/sample-data": {
      "types": "./dist/data/sample-data.d.ts",
      "import": "./dist/data/sample-data.js"
    },
    "./data/platform-detect": {
      "types": "./dist/data/platform-detect.d.ts",
      "import": "./dist/data/platform-detect.js"
    },
    "./llm/provider": {
      "types": "./dist/llm/provider.d.ts",
      "import": "./dist/llm/provider.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openagency/types": "workspace:*",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.5.207",
    "pino": "^9.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pino-pretty": "^11.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
