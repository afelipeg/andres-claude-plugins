# ─── Plinth Next.js App ──────────────────────────────────────────────
# Multi-stage build: install + build Next.js standalone output

# Stage 1: Build
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.30.0 --activate

WORKDIR /app

# Copy workspace manifests first for better caching
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/types/package.json packages/types/
COPY packages/core/package.json packages/core/
COPY packages/engines/package.json packages/engines/
COPY packages/connectors/package.json packages/connectors/
COPY packages/schemas/package.json packages/schemas/
COPY packages/auth/package.json packages/auth/
COPY packages/events/package.json packages/events/
COPY packages/memory/package.json packages/memory/
COPY packages/agent/package.json packages/agent/
COPY packages/hfl/package.json packages/hfl/
COPY packages/email/package.json packages/email/
COPY packages/kb/package.json packages/kb/
COPY apps/api/package.json apps/api/
COPY apps/plinth/package.json apps/plinth/

RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/plinth/ apps/plinth/

# Build all packages + Next.js app
RUN pnpm run build --filter=@openagency/plinth...

# Stage 2: Production (standalone)
FROM node:20-alpine AS runtime

WORKDIR /app

# Copy standalone output
COPY --from=builder /app/apps/plinth/.next/standalone ./
COPY --from=builder /app/apps/plinth/.next/static ./apps/plinth/.next/static
COPY --from=builder /app/apps/plinth/public ./apps/plinth/public
COPY --from=builder /app/apps/plinth/PLINTH.md ./apps/plinth/PLINTH.md

ENV NODE_ENV=production
ENV PORT=3200
ENV HOSTNAME=0.0.0.0

EXPOSE 3200

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3200/login || exit 1

CMD ["node", "apps/plinth/server.js"]
