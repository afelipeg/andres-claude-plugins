# ─── OpenAgency Environment Variables ─────────────────────────────────
# Copy to .env and fill in values. All platform connector vars are optional.

# ─── Core ─────────────────────────────────────────────────────────────
PORT=3100
NODE_ENV=development
LOG_LEVEL=info                          # trace | debug | info | warn | error | fatal
CORS_ORIGIN=*                           # Comma-separated origins or *
API_BASE_URL=http://localhost:3100      # Public URL (used in A2A discovery + OpenAPI)

# ─── Database (optional — runs in-memory without) ─────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openagency

# ─── Redis (optional — uses in-memory event bus without) ──────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production      # Secret for JWT signing
CREDENTIAL_PASSPHRASE=openagency-dev    # Encryption key for stored platform creds

# ─── LLM Providers (at least one required for autonomous agents) ──────
# Detection priority: Anthropic > DeepSeek
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=                       # DeepSeek Chat API (emergency fallback)
# OPENAI_API_KEY=                       # NOT used for reasoning. Only for explicit provider override.
VOYAGE_API_KEY=                         # Optional — for semantic vector search (keyword fallback without)

# ─── Observability (optional) ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=           # e.g. http://localhost:4318

# ─── Google Ads ───────────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ─── Meta Ads ─────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ─── DV360 ────────────────────────────────────────────────────────────
DV360_CLIENT_ID=
DV360_CLIENT_SECRET=

# ─── TikTok Ads ──────────────────────────────────────────────────────
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=

# ─── TikTok Shop ─────────────────────────────────────────────────────
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# ─── Amazon Ads ───────────────────────────────────────────────────────
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# ─── Delivery Engine Tools ────────────────────────────────────────────
SERPER_API_KEY=                         # Google Search via Serper.dev
META_ACCESS_TOKEN=                      # opcional — Meta Ads live data
SERPAPI_KEY=                            # opcional — Google Ads Transparency

# ─── HFL Agent ────────────────────────────────────────────────────────
HFL_DEFAULT_WEBHOOK_URL=                # Slack/email/custom webhook del cliente
HFL_SCORECARD_BASE_URL=http://localhost:5173

# ─── File Storage ─────────────────────────────────────────────────────
FILE_STORAGE_URL=                       # vacío = local /tmp, s3://bucket = S3/R2
FILE_STORAGE_DIR=/tmp/openagency-files  # solo si local

# ─── Frontend (apps/web — prefix with VITE_) ─────────────────────────
VITE_API_URL=http://localhost:3100
VITE_API_KEY=oa_test_dev_default_key_for_local_testing
# VITE_PLATFORM_CONNECTED=true          # Uncomment to hide DEMO badge
